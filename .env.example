BASE_URL=https://bestprice.com.ua
NODE_ENV=stage
EXECUTION_MODE=sample
SAMPLE_SIZE=10
CRAWL_CONCURRENCY=3

# Full crawl: disable failure screenshots (default off when EXECUTION_MODE=full)
# CRAWL_SCREENSHOTS=false

# Optional: override screenshot capture timeout (ms), viewport-only capture
# CRAWL_SCREENSHOT_TIMEOUT_MS=8000
