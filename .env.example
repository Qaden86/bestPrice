BASE_URL=https://bestprice.com.ua
TEST_ENV=stage
TEST_PRODUCT_SLUG=otvertka-49108-stal-sl5x75

# Optional Playwright profile overrides
# PW_RETRIES=1
# PW_WORKERS=2
# PW_ACTION_TIMEOUT_MS=15000
# PW_NAVIGATION_TIMEOUT_MS=45000

NODE_ENV=stage
EXECUTION_MODE=sample
SAMPLE_SIZE=10
CRAWL_CONCURRENCY=3
CRAWL_BROWSER_POOL_SIZE=3
CRAWL_BROWSER_ROTATE_AFTER=200
CRAWL_JOB_TIMEOUT_MS=120000
CRAWL_LEASE_TIMEOUT_MS=150000
CRAWL_RUN_RETENTION=50
SITEMAP_REQUEST_TIMEOUT_MS=15000
DASHBOARD_HOST=127.0.0.1

# Full crawl: disable failure screenshots (default off when EXECUTION_MODE=full)
# CRAWL_SCREENSHOTS=false

# Optional: override screenshot capture timeout (ms), viewport-only capture
# CRAWL_SCREENSHOT_TIMEOUT_MS=8000
