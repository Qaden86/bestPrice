{
  "name": "bestprice",
  "version": "1.0.0",
  "description": "End-to-end test automation framework for bestprice.com.ua built with TypeScript and Playwright.",
  "scripts": {
    "crawl:stage": "dotenv -e .env.stage -- tsx scripts/run-crawl.ts",
    "crawl:prod": "dotenv -e .env.prod -- tsx scripts/run-crawl.ts",
    "crawl:stage:sample": "EXECUTION_MODE=sample dotenv -e .env.stage -- tsx scripts/run-crawl.ts",
    "crawl:prod:sample": "EXECUTION_MODE=sample dotenv -e .env.prod -- tsx scripts/run-crawl.ts",
    "crawl:stage:full": "EXECUTION_MODE=full dotenv -e .env.stage -- tsx scripts/run-crawl.ts",
    "crawl:prod:full": "EXECUTION_MODE=full dotenv -e .env.prod -- tsx scripts/run-crawl.ts",
    "dashboard": "tsx dashboard/server.ts",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "playwright test",
    "test:header": "playwright test tests/header",
    "test:sitemap": "playwright test tests/e2e/sitemap.spec.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "allure:clean": "rm -rf allure-results allure-results-vitest allure-report-playwright allure-report-vitest",
    "test:allure:unit": "vitest run tests/unit",
    "allure:generate:unit": "allure generate allure-results-vitest --clean -o allure-report-vitest",
    "allure:open:unit": "allure open allure-report-vitest",
    "test:allure:integration": "playwright test tests/integration",
    "test:allure:e2e": "playwright test tests/e2e",
    "test:allure:header": "playwright test tests/header",
    "test:allure:sitemap": "playwright test tests/e2e/sitemap.spec.ts",
    "allure:generate:e2e": "allure generate allure-results --clean -o allure-report-playwright",
    "allure:open:e2e": "allure open allure-report-playwright",
    "test:allure": "npm run allure:clean && npm run test:allure:unit && npm run test:allure:integration && npm run test:allure:e2e && npm run test:allure:header && npm run allure:generate:unit && npm run allure:generate:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "@types/xml2js": "^0.4.14",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "allure-vitest": "^3.10.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "p-limit": "^7.3.0",
    "typescript": "^6.0.3",
    "xml2js": "^0.6.2"
  }
}
