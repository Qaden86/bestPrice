{
  "name": "bestprice",
  "version": "1.0.0",
  "description": "End-to-end test automation framework for bestprice.com.ua built with TypeScript and Playwright.",
  "scripts": {
    "crawl:stage": "dotenv -e .env.stage -- tsx scripts/run-crawl.ts",
    "crawl:prod": "dotenv -e .env.prod -- tsx scripts/run-crawl.ts",
    "crawl:stage:sample": "EXECUTION_MODE=sample dotenv -e .env.stage -- tsx scripts/run-crawl.ts",
    "crawl:prod:sample": "EXECUTION_MODE=sample dotenv -e .env.prod -- tsx scripts/run-crawl.ts",
    "crawl:stage:full": "EXECUTION_MODE=full CRAWL_SCREENSHOTS=false dotenv -e .env.stage -- tsx scripts/run-crawl.ts",
    "crawl:prod:full": "EXECUTION_MODE=full CRAWL_SCREENSHOTS=false CRAWL_CONCURRENCY=10 dotenv -e .env.prod -- tsx scripts/run-crawl.ts",
    "dashboard": "tsx dashboard/server.ts",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --include='tests/integration/**'",
    "test:e2e": "playwright test",
    "test:header": "playwright test tests/e2e/crawl.smoke.spec.ts",
    "test:sitemap": "playwright test tests/e2e/sitemap.spec.ts",
    "test:all": "npm run test && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.7.0",
    "@types/xml2js": "^0.4.14",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "p-limit": "^7.3.0",
    "typescript": "^6.0.3",
    "xml2js": "^0.6.2"
  }
}
